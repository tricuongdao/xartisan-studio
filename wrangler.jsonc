{
  // Cloudflare Workers static assets — deploy with: npx wrangler deploy
  // site/ is uploaded as-is; no build step.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xartisan-studio",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./site",
    // Canonicals and sitemap use URLs without a trailing slash (/contact),
    // so the Worker must not redirect those to /contact/.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
